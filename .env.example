# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/rent_control

# Allowed browser origins for CORS (comma-separated). Mobile clients are unaffected.
# In production include the deployed web domain, e.g.:
# CORS_ORIGINS=https://app.example.com,https://web.up.railway.app
CORS_ORIGINS=http://localhost:5173

# S3 bucket name (for future real S3 integration; currently mocked)
S3_BUCKET=mock-bucket

# Firebase project ID (used to verify Firebase ID tokens)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Storage bucket name (e.g. your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase service account key as a single-line JSON string (used for Storage file cleanup)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
