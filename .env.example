# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/rent_control

# Allowed browser origins for CORS (comma-separated). Mobile clients are unaffected.
# In production include the deployed web domain, e.g.:
# CORS_ORIGINS=https://app.example.com,https://web.up.railway.app
CORS_ORIGINS=http://localhost:5173

# Firebase project ID (used to verify Firebase ID tokens)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Storage bucket name (e.g. your-project.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase service account key as a single-line JSON string (used for Storage file cleanup)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Push notifications (Expo Push Service).
# Optional; only needed if Expo "Enhanced Security" (access tokens) is enabled.
EXPO_ACCESS_TOKEN=
# Shared secret guarding POST /internal/run-reminders (sent as the X-Cron-Secret header).
# Set this and have an external daily scheduler call the endpoint with the same value.
# The same secret also guards POST /internal/run-cpi-indexing (call it ~monthly).
REMINDER_CRON_SECRET=

# AI lease extraction (POST /extract/lease) — Anthropic Claude.
# Leave empty to disable the endpoint (it returns 503; the rest of the app is unaffected).
ANTHROPIC_API_KEY=
# Model used for extraction. Sonnet is the cost/accuracy default; switch to
# claude-opus-4-8 if accuracy on hard scanned leases isn't good enough.
EXTRACTION_MODEL=claude-sonnet-4-6

# Consumer Price Index (CPI) rent linkage — CBS (cbs.gov.il) public price-index API.
# Keyless; defaults are fine. CPI_INDEX_ID 120010 is the general Consumer Price Index.
CBS_API_BASE_URL=https://api.cbs.gov.il
CPI_INDEX_ID=120010
